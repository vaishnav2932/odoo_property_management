<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="own_company_record" model="ir.rule">
        <field name="name">User own company record</field>
        <field name="model_id" ref="model_rental_and_lease_management"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>