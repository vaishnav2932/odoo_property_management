<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_rent_lease_pdf">
        <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="mb-3">
                            <h2>Rent Lease Report</h2>
                            <p>
                                <strong>Printed on:</strong>
                                <t t-esc="today"/>
                            </p>
                            <p>
                                <strong>Property:</strong>
                                <t t-esc="data['form_data'].get('property_name')"/>
                            </p>
                        </div>
                        <table class="table table-sm mt-3" style="width: 100%; border-collapse: collapse;" border="1">
                            <thead>
                                <tr>
                                    <th>Property</th>
                                    <th>Owner</th>
                                    <th>Sequence</th>
                                    <th>Tenant</th>
                                    <th>State</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Start</th>
                                    <th>End</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['report_lines']" t-as="record">
                                    <td>
                                        <t t-esc="record[0]"/>
                                    </td>
                                    <td>
                                        <t t-esc="record[1]"/>
                                    </td>
                                    <td>
                                        <t t-esc="record[2]"/>
                                    </td>
                                    <td>
                                        <t t-esc="record[3]"/>
                                    </td>
                                    <td>
                                        <t t-esc="record[4]"/>
                                    </td>
                                    <td>
                                        <t t-esc="record[5]"/>
                                    </td>
                                    <td>
                                        <t t-esc="record[8]"/>
                                    </td>
                                    <td>
                                        <t t-esc="record[6]"/>
                                    </td>
                                    <td>
                                        <t t-esc="record[7]"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
    </template>
</odoo>

