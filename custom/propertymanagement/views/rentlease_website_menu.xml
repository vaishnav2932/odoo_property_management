<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="website_rent_lease_menu" model="website.menu">
        <field name="name">Rent/Lease</field>
        <field name="url">/rentlease</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">90</field>
    </record>
    <template id="rentlease_form_template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container">
                    <div class="header">
                        <h3>Rental or Lease</h3>
                    </div>

                    <form enctype="multipart/form-data"
                          class="o_mark_required">

                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>
                        <div class="s_website_form_rows row s_col_no_bgcolor">
                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto
                                                       s_website_form_label"
                                       style="width: 200px" for="studio1">
                                    <span class="s_website_form_label_content">
                                        Tenant
                                    </span>
                                    <span class="s_website_form_mark">*</span>
                                </label>
                                <div class="col-sm mt-3">
                                    <input id="tenant" name="tenant"

                                           class="form-control s_website_form_input"
                                           required="1" t-att-value="tenant_id">

                                        <!--                                        <option/>-->
                                        <!--                                        <option t-foreach="tenant_id"-->
                                        <!--                                                t-as="tenant"-->
                                        <!--                                                t-att-value="tenant['id']" t-out="tenant['name']"/>-->
                                    </input>
                                </div>
                                <label class="col-form-label
                                            col-sm-auto s_website_form_label"
                                       style="width: 200px" for="studio1">
                                    <span class="s_website_form_label_content">
                                        Type
                                    </span>
                                    <span class="s_website_form_mark">*</span>
                                </label>
                                <div class="col-sm mt-3">
                                    <select name="type" class="type form-control s_website_form_input"
                                            required="1">
                                        <option value="">Select a type</option>
                                        <t t-foreach="type_options" t-as="option">
                                            <option t-att-value="option[0]">
                                                <t t-esc="option[1]"/>
                                            </option>
                                        </t>
                                    </select>


                                </div>
                                <div class="row mt-3">
                                    <div class="col">
                                        <label class="col-form-label
                                            col-sm-auto s_website_form_label"
                                               style="width: 200px" for="studio1">
                                            <span class="s_website_form_label_content">
                                                Start Date
                                            </span>
                                            <span class="s_website_form_mark">*</span>
                                        </label>
                                        <div class="col-sm">
                                            <input type="date"
                                                   class="start_date form-control s_website_form_input"
                                                   name="start_date" required="1"/>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <label class="col-form-label
                                            col-sm-auto s_website_form_label"
                                               style="width: 200px" for="studio1">
                                            <span class="s_website_form_label_content">
                                                End Date
                                            </span>
                                            <span class="s_website_form_mark">*</span>
                                        </label>
                                        <div class="col-sm">
                                            <input type="date"
                                                   class="end_date form-control s_website_form_input"
                                                   name="end_date" required="1"/>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <div class='row ml-1' style="width:99%;">
                                            <div class="form-group col-12 show_total_project">
                                                <div class="row s_col_no_resize s_col_no_bgcolor">

                                                    <table class="table table-bordered mt-3 total_project_costs"
                                                           id="property_table">
                                                        <thead>
                                                            <tr>
                                                                <td>
                                                                    <strong>
                                                                        Property
                                                                    </strong>
                                                                </td>
                                                                <td>
                                                                    <strong>
                                                                        Amount
                                                                    </strong>
                                                                </td>
                                                                <td>
                                                                    <strong>
                                                                        Total Days
                                                                    </strong>
                                                                </td>
                                                                <td>
                                                                    <strong>
                                                                        Total Amount
                                                                    </strong>
                                                                </td>
                                                                <td width="5%"/>
                                                            </tr>
                                                        </thead>

                                                        <div class="collapse">
                                                            <tbody>
                                                                <tr class="property_order_line">
                                                                    <td>
                                                                        <select name="property_id"
                                                                                class="property_id form-control s_website_form_input">
                                                                            <option value="">Select a property</option>
                                                                            <t t-foreach="properties" t-as="prop">
                                                                                <option t-att-value="prop.id">
                                                                                    <t t-esc="prop.property_name"/>
                                                                                </option>
                                                                            </t>
                                                                        </select>


                                                                    </td>
                                                                    <td>
                                                                        <div class="d-flex">
                                                                            <span class="mt-2"
                                                                                  style="margin-right: 0.5rem !important;"/>
                                                                            <input
                                                                                    class="amount form-control total_cost"
                                                                                    name="amount"
                                                                                    t-att-value="property_amount"/>
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <div class="d-flex">
                                                                            <span class="mt-2"
                                                                                  style="margin-right: 0.5rem !important;"/>
                                                                            <input
                                                                                   name="total_days"
                                                                                   class="total_days form-control s_website_form_input operation">
                                                                                <option/>
                                                                            </input>
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <div class="d-flex">
                                                                            <span class="mt-2"
                                                                                  style="margin-right: 0.5rem !important;"/>
                                                                            <input
                                                                                   name="total_amount"
                                                                                   class="total_amount form-control s_website_form_input operation">
                                                                                <option/>
                                                                            </input>
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <button class="btn fa fa-trash-o remove_line"
                                                                                style="color: red;
                                                                                          padding: 0px;
                                                                                          margin-left: -6px;
                                                                                          margin-top: 6px;
                                                                                          margin-bottom:15px;"
                                                                                name="delete"
                                                                                aria-label="Delete row 1"/>
                                                                    </td>

                                                                </tr>

                                                            </tbody>
                                                        </div>
                                                    </table>
                                                </div>
                                            </div>
                                            <div>
                                                <button type="submit"
                                                        class="btn btn-info
                                              add_total_property button-color"
                                                        style="float: right;
                                        margin-right: -15px;">
                                                    <i class="fa fa-plus"/>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="clearfix oe_login_buttons">
                                        <button type="button"
                                                class="custom_create btn btn-primary btn-block">
                                            Create Request
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </t>
    </template>
</odoo>



