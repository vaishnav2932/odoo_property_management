<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_rent_lease" name="Rental and Lease" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'rentalandlease'" class="breadcrumb-item">Rental and Lease</li>
        </xpath>
    </template>
    <template id="portal_my_home_menu_rentalandlease" name="Rental and Lease" inherit_id="portal.portal_my_home"
              customize_show="True" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/property_management_erp/static/src/img/bag.svg'"/>
                <t t-set="title">Rent and Lease</t>
                <t t-set="url" t-value="'/rentalandlease'"/>
                <t t-set="text">View Rent and Lease Orders</t>
                <t t-set="placeholder_count" t-value="'rent_lease_counts'"/>
            </t>
        </div>
    </template>
    <template id="portal_my_home_rentlease_views" name="My Rental and Lease">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th class="text-center">Reference</th>
                        <th class="text-end">start Date</th>
                        <th class="text-end">End Date</th>
                        <th class="text-center">Type</th>
                        <th class="text-end">Amount</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <t t-foreach="rentlease" t-as="rentlease">
                    <tr>
                        <td class="text-center">
                            <a t-attf-href="/rentalandlease/#{rentlease.id}">
                                <t t-out="rentlease.sequence">
                                </t>
                            </a>
                        </td>
                        <td class="text-end">
                            <t t-out="rentlease.start_date">
                            </t>
                        </td>
                        <td class="text-end">
                            <t t-out="rentlease.end_date">
                            </t>
                        </td>
                        <td class="text-center">
                            <t t-out="rentlease.type">
                            </t>
                        </td>
                        <td class="text-end">
                            <t t-out="rentlease.total">
                            </t>
                        </td>
                        <td class="text-center">
                            <t t-out="rentlease.state">
                            </t>
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <template id="portal_my_home_rentlease_form_views" name="My Rental and Lease form view"
              inherit_id="portal.portal_sidebar">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-if="page_name == 'rentalandlease_form'">
                <div class="row o_portal_sale_sidebar">
                    <div class="flex col-lg-4 col-xxl-3 d-print-none">
                        <div class="o_portal_sidebar_content flex-grow-1 mb-4 mb-lg-0 pe-lg-4">
                            <div class="position-relative d-flex align-items-center justify-content-md-center justify-content-lg-between flex-wrap gap-2">
                                <h2 class="mb-0 text-break">
                                   <span t-esc="rentlease.currency_symbol"/><span t-esc="rentlease.total" />
                                </h2>
                            </div>
                            <div class="d-flex flex-column gap-4 mt-3">
                                <div class="navspy flex-grow-1 ps-0">
                                    <ul class="nav flex-column bs-sidenav">
                                        <li class="nav-item">
                                            <span>Order -
                                                <t t-esc="rentlease.sequence"/>
                                            </span>
                                        </li>
                                    </ul>
                                </div>
                                <div>
                                    <h6>
                                        <small class="text-muted">Your contact</small>
                                    </h6>
                                    <div class="o_portal_contact_details d-flex flex-column gap-2 ">
                                        <div class="d-flex gap-2">
                                            <span class="d-block lh-1 mb-1 ">
                                                <t t-esc="rentlease.tenant_id.complete_name"/>
                                            </span>


                                        </div>
                                        <div>
                                            <span class="d-block lh-1 mb-1 ">
                                                <t t-esc="rentlease.tenant_id.phone"/>
                                            </span>
                                        </div>
                                        <div>
                                            <span class="d-block lh-1 mb-1 ">
                                                <t t-esc="rentlease.tenant_id.email"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="vr d-none d-lg-block bg-300 ml"/>

                    </div>
                    <div class="col-12 col-lg-8 col-xxl-9 mt-5 mt-lg-0">
                        <div class="pb-5">
                            <div>
                                <div class="border-bottom-0 pt-0 pb-3">
                                    <h2>
                                        Rent/Lease Order -
                                        <t t-esc="rentlease.sequence"/>

                                    </h2>
                                </div>
                            </div>
                            <div id="content">
                                <div id="informations" class="row">
                                    <div id="orderinfo" class="col-12 col-lg-6 mb-4">
                                        <h5>Information</h5>
                                        <hr class="mt-1 mb-2"/>
                                        <table class="table table-borderless table-sm">
                                            <tbody style="white-space:nowrap">
                                                <tr>
                                                    <th class="ps-0 pb-0">Start Date :
                                                        <span>
                                                            <t t-esc="rentlease.start_date"/>
                                                        </span>
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <th class="ps-0 pb-0">End Date :
                                                        <span>
                                                            <t t-esc="rentlease.end_date"/>
                                                        </span>
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <th class="ps-0 pb-0">Total Days :
                                                        <span>
                                                            <t t-esc="rentlease.total_days"/>
                                                        </span>
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <th class="ps-0 pb-0">Type :
                                                        <span>
                                                            <t t-esc="rentlease.type"/>
                                                        </span>
                                                    </th>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div id="customer_info" class="col-12 col-lg-6 mb-4">
                                        <h5 class="mb-1">
                                            Address
                                        </h5>
                                        <hr class="mt-1 mb-2"/>
                                        <div>
                                            <t t-esc="rentlease.tenant_id.company_id.name"/>
                                        </div>
                                        <div>
                                            <t t-esc="rentlease.tenant_id.company_id.street"/>
                                        </div>
                                        <div>
                                            <t t-esc="rentlease.tenant_id.company_id.street2"/>
                                        </div>
                                        <div>
                                            <t t-esc="rentlease.tenant_id.company_id.city"/>
                                        </div>
                                        <div>
                                            <t t-esc="rentlease.tenant_id.company_id.state_id.name"/>
                                        </div>
                                        <div>
                                            <t t-esc="rentlease.tenant_id.email"/>
                                        </div>
                                        <div>
                                            <t t-esc="rentlease.tenant_id.phone"/>
                                        </div>
                                    </div>
                                </div>
                                <section id="details" style="page-break-inside: auto;">
                                    <div class="table-responsive">
                                        <table class="table table-sm" id="sales_order_table">
                                            <thead>
                                                <tr>
                                                    <th class="text-start" id="product_name_header">
                                                        Property
                                                    </th>
                                                    <th class="text-start" id="product_unit_price_header">
                                                        Unit Price
                                                    </th>
                                                    <th class="text-start" id="product_Amount_header">
                                                        State
                                                    </th>
                                                    <th class="text-start" id="product_Amount_header">
                                                        Amount
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody class="order_body">
                                                <t t-foreach="rentlease.property_ids" t-as="property_record">
                                                <tr>
                                                    <td>
                                                        <span t-esc="property_record.property_id.property_name"/>
                                                    </td>
                                                    <td>
                                                       <span t-esc="rentlease.currency_symbol"/> <span t-esc="property_record.amount"/>
                                                    </td>
                                                     <td>
                                                        <span t-esc="rentlease.state"/>
                                                    </td>
                                                    <td>
                                                       <span t-esc="rentlease.currency_symbol"/> <span t-esc="property_record.total_amount"/>
                                                    </td>
                                                </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div id="total" name="total" style="page-break-inside: avoid;">
                                        <div class="col-xs-7 col-md-5 ms-auto">
                                            <table class="table table-sm" name="order_total_details">
                                                <tbody>
                                                    <tr class="o_total">
                                                        <td>
                                                            <strong>Total</strong>
                                                        </td>
                                                        <td>
                                                            <strong data-oe-type="monetary"><span t-esc="rentlease.currency_symbol"/><t t-esc="rentlease.total"/> </strong>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                            <chatter>
                                            </chatter>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
