<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="property_detail_view">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="row" style="margin-top:10%;margin-bottom:10%;">
                    <div class="col-6">
                        <img t-att-src="'/web/image/property.management/%s/property_image'
                            % properties.id"
                             class="img-fluid"
                             alt="Property Image"
                             style="width:100%;height:100%;object-fit:cover;
                                 display:block;margin:0 auto;"/>
                    </div>
                    <div class="col-3">
                        <h2 class="mb-3">
                            <t t-esc="properties.property_name"/>
                        </h2>
                        <div class="mb-3">
                            <span class="me-2 h5">Rent Amount :</span>
                            <t t-esc="properties.currency_symbol"/>
                            <t t-esc="properties.rent"/>

                        </div>
                        <div class="mb-3">
                            <span class="me-2 h5">Lease Amount :</span>
                            <t t-esc="properties.currency_symbol"/>
                            <t t-esc="properties.legal_amount"/>

                        </div>
                        <h5>Address</h5>
                        <p>
                            <t t-esc="properties.street1"/>,
                            <t t-esc="properties.street2"/>
                            <br></br>
                            <t t-esc="properties.zip"/>
                            <br></br>
                            <t t-esc="properties.state_id.name"/>,
                            <t t-esc="properties.country_id.name"/>
                        </p>
                        <div>
                            <span class="h5">Owner :</span>
                            <t t-esc="properties.owner_id.complete_name"/>
                        </div>
                        <br></br>
                        <div>
                            <span class="h5">Built date :</span>
                            <t t-esc="properties.built_date"/>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="mt-4">
                            <h5>Facilities:</h5>
                            <ul>
                                <t t-foreach="properties.facility_ids"
                                   t-as="facility">
                                    <li>
                                        <t t-esc="facility.facility"/>
                                    </li>
                                </t>
                            </ul>
                            <div class="description">
                                <p class="mb-4">
                                    <t t-esc="properties.description"/>
                                </p>
                            </div>
                            <div class="state">
                                <span class="h5">State :</span>
                            <t t-esc="dict(properties._fields['state']
                            ._description_selection(properties.env)).get(properties.state)"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>