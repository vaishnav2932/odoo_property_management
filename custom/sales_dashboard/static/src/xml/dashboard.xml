<?xml version="1.0" encoding="UTF-8" ?>

<templates>
    <t t-name="sales_dashboard.SaleDashboard">
        <div class="">
            <div>
                <center>
                    <h1 style="margin:20px;">
                        Sales Dashboard
                    </h1>
                </center>
            </div>
        </div>
        <div class="row main-section"
             style="display:flex;justify-content:center;">
            <!--                        quotation Tile-->
            <div id="quotations" class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                 style=" overflow: hidden; padding-top: 30px;">
                <div class="oh-card" type="object" t-on-click="ViewQuotations"
                     style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
                display: flex; justify-content: center;" role="button">
                    <div class="oh-card-body"
                         style="padding: 5px 5px; float: left; width: 100%;
                          height: auto; box-sizing: border-box; margin: 0;">
                        <div class="stat-widget-one">
                            <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                <div style="background:#ff4d94; width:65px; text-align: center;">
                                    <i class="fa fa-tasks text-mauve"
                                       style="font-size:50px;"/>
                                </div>
                                <div class="stat_content" style="
                                  text-align: center; font-weight: bold;
                                  padding-top: 20px; padding-left: 80px;">
                                    <div class="stat_count_lead"
                                         style="font-size: 17px;">
                                        <span id="templates">
                                            <div id="quotation">
                                                <span t-esc="state.total_quotation"/>
                                            </div>
                                        </span>
                                    </div>
                                    <div class="stat-head"
                                         style="font-size: 14px;">Quotations
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!--       order Tile-->
            <div id="orders"
                 class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                 style=" overflow: hidden; padding-top: 30px;">
                <div class="oh-card" type="object" t-on-click="ViewOrders"
                     style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
                display: flex; justify-content: center;" role="button">
                    <div class="oh-card-body"
                         style="padding: 5px 5px; float: left; width: 100%;
                          height: auto; box-sizing: border-box; margin: 0;">
                        <div class="stat-widget-one">
                            <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                <div style="background:yellow; width:65px; text-align: center;">
                                    <i class="fa fa-trophy  text-mauve"
                                       style="font-size:50px;"/>
                                </div>
                                <div class="stat-content" style="
                                  text-align: center; font-weight: bold;
                                  padding-top: 20px; padding-left: 80px;">
                                    <div class="stat_count_opp"
                                         style="font-size: 17px;">
                                        <div id="sale_order">
                                            <span t-esc="state.total_sale_order"/>
                                        </div>
                                    </div>
                                    <div class="stat-head"
                                         style="font-size: 14px;">Orders
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!--            Expected Revenue -->
            <div id="expected_revenue"
                 class="col-md-4 col-sm-6 tot_tasks oh-payslip"
                 style=" overflow: hidden; padding-top: 30px;">
                <div class="oh-card" style="box-shadow:2px 4px 8px 2px rgba(0,0,0.3,0.2);
                display: flex; justify-content: center;" role="button">
                    <div class="oh-card-body"
                         style="padding: 5px 5px; float: left; width: 100%;
                          height: auto; box-sizing: border-box; margin: 0;">
                        <div class="stat-widget-one">
                            <div class="stat-icon bg-mauve-light d-flex justify-content-left align-items-left">
                                <div style="background:#bf80ff;; width:65px; text-align: center;">
                                    <i class="fa fa-usd  text-mauve"
                                       style="font-size:50px;"/>
                                </div>
                                <div class="stat-content" style="
                                  text-align: center; font-weight: bold;
                                  padding-top: 20px; padding-left: 80px;">
                                    <div class="stat_count_ex_rev"
                                         style="font-size: 17px;">
                                        <div id="total_revenue">
                                            <span t-esc="state.total_revenue"/>
                                        </div>
                                    </div>
                                    <div class="stat-head"
                                         style="font-size: 14px;">Total
                                        revenue
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--        chart-->

        <select class="form-control m-5" id="main_filter"
                style="width:20%;">
            <option value="">Filter</option>
            <option value="year_count">Year by count</option>
            <option value="year_price">Year by price</option>
            <option value="month_count">Month by count</option>
            <option value="month_price">Month by price</option>
            <option value="day_count">Day by count</option>
            <option value="day_price">Day by price</option>
        </select>

        <div id="date_range_inputs" class="m-5" style="width:40%;">
            <label for="from_date">From:</label>
            <input type="date" id="from_date" class="form-control"/>
            <label for="to_date">To:</label>
            <input type="date" id="to_date" class="form-control"/>
            <button id="apply_date_range" class="btn btn-primary mt-2">
                Apply
            </button>
        </div>
        <div class="row">
            <div class="row border border-4 rounded m-5"
                 style="margin-top:5%;width:60%;">

                <div class="col-6 mt-5">

                    <center>
                        <h2>Sales by sales team</h2>
                    </center>
                    <select class="form-control" id="sale_filter"
                            style="width:30%;">
                        <option value="">Filter</option>
                        <option value="val1">By Count</option>
                        <option value="val2">By Price</option>
                    </select>
                    <canvas id="dashboard_chart" height="400px"
                            width="500px"/>
                </div>
                <div class="col-6 mt-5">
                    <center>
                        <h2>Sales by sales person</h2>
                    </center>
                    <select class="form-control" id="sale_person_filter"
                            style="width:30%;">
                        <option value="">Filter</option>
                        <option value="val1">By Count</option>
                        <option value="val2">By Price</option>
                    </select>
                    <canvas id="dashboard_sales_chart" height="400px"
                            width="500px"/>
                </div>
            </div>
            <div class="col-4 mt-5" style="width:500px;">
                <center>
                    <h2>Top Customers</h2>
                </center>
                <table class="table table-bordered mt-3" id="top_customers">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Total Orders</th>
                            <th>Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.customers" t-as="customer"
                           t-key="customer.partner">
                            <tr>
                                <td>
                                    <t t-esc="customer.partner"/>
                                </td>
                                <td>
                                    <t t-esc="customer.total_orders"/>
                                </td>
                                <td>
                                    <t t-esc="customer.total_amount"
                                       t-options="{widget: 'monetary', display_currency: 'company_currency'}"/>
                                </td>
                            </tr>
                        </t>

                    </tbody>
                </table>
            </div>
        </div>

        <div class="row m-5">
            <div class="col-8">
                <center>
                    <h2>Lowest Selling Products</h2>
                </center>
                <canvas id="dashboard_lowest_product_chart"/>
            </div>
            <div class="col-4" style="width:30%;">
                <center>
                    <h2>Order Status</h2>
                </center>
                <canvas id="dashboard_order_status_chart"/>
            </div>
        </div>

        <div class="row m-5">
            <div class="col-8">
                <center>
                    <h2>Highest Selling Products</h2>
                </center>
                <canvas id="dashboard_highest_product_chart"/>
            </div>
            <div class="col-4" style="width:30%;">
                <center>
                    <h2>Invoice Status</h2>
                </center>
                <canvas id="dashboard_invoice_status_chart"/>
            </div>
        </div>
