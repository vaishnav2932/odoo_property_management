<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    list view -->
    <record id="property_line_view_list" model="ir.ui.view">
        <field name="name">property.line.view.list</field>
        <field name="model">property.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="property_id"/>
                <field name="amount"/>
                <field name="total_days"/>
                <field name="total_amount"/>
                <field name="quantity_invoiced"/>
<!--                <field name="quantity_to_invoice"/>-->
            </list>
        </field>
    </record>
    <!--    window action-->
    <record id="action_property_line" model="ir.actions.act_window">
        <field name="name">property line</field>
        <field name="res_model">property.line</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="0_view_noncontent_smiling_face">Create New product</p>
        </field>
    </record>
</odoo>