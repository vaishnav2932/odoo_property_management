<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--property form view-->
    <record id="property_management_view_form" model="ir.ui.view">
        <field name="name">property.management.view.form</field>
        <field name="model">property.management</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable':'1'}"/>
                </header>
                <sheet>
                    <div name="button_box">
                        <button type="object" name="action_get_rent_and_lease" string="rent/lease" icon="oi-group">
                            <field string="rent/lease" name="rental_lease_count" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="property_image" class="oe_avatar" widget="image"/>
                    <h1>
                        <field name="property_name" placeholder="Name..."/>
                    </h1>
                    <group>
                        <group>
                            <span class="o_form_label o_td_label o_address_type fw-bold">Permanent Address</span>
                            <div class="o_address_format">
                                <field name="street1" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State"/>
                                <field name="country_id" class="o_address_state" placeholder="Country"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                            </div>
                            <field name="facility_ids" widget="many2many_tags" string="Facilities"/>
                        </group>
                        <group>
                            <field name="legal_amount"/>
                            <field name="rent"/>
                            <field name="owner_id"/>
                            <field name="built_date"/>
                            <field name="can_be_sold"/>
                        </group>
                        <notebook>
                            <page name="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <chatter>
                </chatter>
            </form>
        </field>
    </record>
    <!--property list view-->
    <record id="property_management_view_list" model="ir.ui.view">
        <field name="name">property.management.view.list</field>
        <field name="model">property.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_name" width="100px"/>
                <field name="owner_id" width="100px"/>
                <field name="legal_amount" width="100px"/>
                <field name="rent" width="100px"/>
                <field name="can_be_sold" width="100px"/>
                <field name="built_date" width="100px"/>
            </list>
        </field>
    </record>
    <!--   property search view-->
    <record id="property_management_view_search" model="ir.ui.view">
        <field name="name">property.management.view.search</field>
        <field name="model">property.management</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Can be sold" name="can_be_sold" domain="[('can_be_sold', '=', 'True')]"/>
                <group string="Group By">
                    <filter string="Country" name="country_id" context="{'group_by': 'country_id'}"/>
                    <filter string="Stage" name="state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <!-- window action -->
    <record id="action_property_management" model="ir.actions.act_window">
        <field name="name">Property Management</field>
        <field name="res_model">property.management</field>
        <field name="view_ids" eval="[Command.clear(),
    Command.create({'view_mode': 'list', 'sequence': 1, 'view_id': ref('property_management_view_list')}),
    Command.create({'view_mode': 'form', 'sequence': 2, 'view_id': ref('property_management_view_form')}),
]"/>
        <field name="help" type="html">
            <p>
                <i class="oi oi-odoo"/>
                Create Property
            </p>
        </field>
    </record>
</odoo>
