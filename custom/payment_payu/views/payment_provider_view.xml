<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="payment_provider_aps" model="payment.provider">
        <field name="name">Payu Payment Services</field>
        <field name="image_128" type="base64"
               file="payment_payu/static/description/icon.png"/>
        <field name="module_id" ref="base.module_payment_payu"/>
        <field name="payment_method_ids"
               eval="[Command.set([
                    ref('payment_payu.payment_method_payu'),
                    ref('payment.payment_method_card'),
                    ref('payment.payment_method_paypal'),
           ])]"
        />
        <field name="code">payu</field>
        <field name="redirect_form_view_id" ref="redirect_form"/>
    </record>

    <record id="payment_provider_payu_form" model="ir.ui.view">
        <field name="name">PayU Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group invisible="code != 'payu'">
                    <field name="payu_merchant_key"/>
                    <field name="payu_salt"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
