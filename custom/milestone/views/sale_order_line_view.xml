<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_sale_order_line_inherit" model="ir.ui.view">
        <field name="name">sale.order.line.inherit</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_delivered']" position="after">
                <field name="milestone"/>
            </xpath>
        </field>
    </record>
    <record id="action_sale_order_line" model="ir.actions.act_window">
        <field name="name">Sale Order Line</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>