<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Reporting Form -->
    <record id="property_wizard_view_form" model="ir.ui.view">
        <field name="name">property.wizard.view.form</field>
        <field name="model">property.wizard</field>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <form string="Property Wizard">
                <group>
                    <field name="property_id"/>
                    <field name="owner_id"/>
                    <field name="property_type"/>
q                    <field name="state"/>
                    <field name="from_date"/>
                    <field name="to_date"/>
                </group>
                <footer>
                    <button name="action_pdf" string="PDF" type="object"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!--    window action-->
    <record id="action_property_wizard" model="ir.actions.act_window">
        <field name="name">Wizard</field>
        <field name="res_model">property.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="property_wizard_view_form"/>
<!--        <field name="help" type="html">-->
<!--            <p class="o_view_nocontent_smiling_face">Create your first facility</p>-->
<!--        </field>-->
    </record>
</odoo>
