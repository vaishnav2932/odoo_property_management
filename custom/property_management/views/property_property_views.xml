<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    create form view-->
    <record id="property_property_view_form" model="ir.ui.view">
        <field name="name">property.property.view.form</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div name="button_box" position="inside">
                        <button class="oe_stat_button"
                                type="object"
                                icon="fa-pencil-square-o"
                                name="action_get_rent_lease_record">
                            <field string="Rent/lease" name="rent_lease_count" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="image_1920" class="oe_avatar" widget="image"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. House"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <span class="o_form_label o_td_label o_address_type fw-bold">Permanent Address</span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State"/>
                                <field name="country_id" class="o_address_state" placeholder="Country"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                            </div>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="built_date"/>
                            <field name="can_be_sold"/>
                            <field name="legal_amount" widget="monetary"/>
                            <field name="rent"/>
                            <field name="facility_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="internal_notes">
                            <field name="description" placeholder="Add a description..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!--    list view-->
    <record id="property_property_view_list" model="ir.ui.view">
        <field name="name">property.property.view.list</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <list string="Property's list">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="built_date"/>
                <field name="can_be_sold"/>
                <field name="legal_amount"/>
                <field name="rent"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <!--    search view-->
    <record id="property_property_view_search" model="ir.ui.view">
        <field name="name">property.property.view.search</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <search string="Property's search">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="built_date"/>
                <field name="can_be_sold"/>
                <field name="legal_amount"/>
                <field name="rent"/>
                <field name="state"/>
                <separator/>
                <filter string="Can Be Sold" name="can be sold" domain="[('can_be_sold', '=', 'True')]"/>
                <group expand="1" string="Group By">
                    <filter string="By County" name="by county"
                            context="{'group_by':'country_id'}"/>
                    <filter string="By State" name="by state"
                            context="{'group_by':'state_id'}"/>
                    <filter string="By Status" name="by status"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <!--    window action-->
    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Property</field>
        <field name="res_model">property.property</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'sequence': 1, 'view_id': ref('property_property_view_list')}),
            Command.create({'view_mode': 'kanban', 'sequence': 2, 'view_id': ref('property_property_view_form')}),]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first property</p>
        </field>
    </record>
</odoo>

