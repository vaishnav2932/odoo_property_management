<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
<!--        for sending mail while changing state-->
        <record id="send_mail_on_status_change" model="ir.cron">
            <field name="name">Status change</field>
            <field name="model_id" ref="model_property_management"/>
            <field name="state">code</field>
            <field name="code">model.send_mail()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name='interval_number'>1</field>
            <field name='interval_type'>days</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/>
            <field name="priority">1</field>
        </record>
<!--        for auto expiry-->
        <record id="auto_expiry_on_due_date" model="ir.cron">
            <field name="name">Auto expiry based on due date</field>
            <field name="model_id" ref="model_property_management"/>
            <field name="state">code</field>
            <field name="code">model.auto_expiry()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name='interval_number'>1</field>
            <field name='interval_type'>days</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/>
            <field name="priority">2</field>
        </record>
<!--        for payment follow-up email-->
        <record id="send_mail_payment_follow_up" model="ir.cron">
            <field name="name">Payment Follow-up</field>
            <field name="model_id" ref="model_property_management"/>
            <field name="state">code</field>
            <field name="code">model.payment_followup()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name='interval_number'>7</field>
            <field name='interval_type'>days</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:00:00')"/>
            <field name="priority">3</field>
        </record>
    </data>
</odoo>
